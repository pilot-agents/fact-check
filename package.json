{
  "name": "@pilot-agents/fact-check-mcp",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "version": "0.3.0",
  "description": "MCP server that records and checks an AI agent's fact-checking work: quotes must be found verbatim in fetched evidence, coverage is computed from the source text, and the report is generated from the ledger - not from what the agent claims. It does not judge whether a claim is true.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fact-check",
    "fact-checking",
    "verification",
    "citation",
    "evidence",
    "ai-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pilot-agents/fact-check.git"
  },
  "bugs": {
    "url": "https://github.com/pilot-agents/fact-check/issues"
  },
  "homepage": "https://github.com/pilot-agents/fact-check#readme",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.22.1 || ^24.11.1"
  },
  "bin": {
    "fact-check-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx scripts/clean-dist.ts && tsc -p tsconfig.build.json && tsx scripts/make-bin-executable.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:leaks": "tsx scripts/leak-check/main.ts",
    "verify": "pnpm lint && pnpm test && pnpm build && pnpm check:leaks && pnpm e2e && pnpm e2e:package && pnpm e2e:dev",
    "test": "vitest run",
    "e2e": "pnpm build && tsx e2e/run-e2e.ts",
    "e2e:package": "pnpm build && tsx e2e/run-package-e2e.ts",
    "e2e:dev": "tsx e2e/run-dev-mcp-e2e.ts",
    "dev:mcp": "tsx scripts/dev-mcp/main.ts",
    "start": "tsx src/index.ts",
    "viewer": "tsx src/viewer/main.ts",
    "report:rebuild": "tsx src/report/rebuild-cli.ts",
    "report:export": "tsx src/report/export-cli.ts",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:leaks --require-denylist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
